# Copy to .env.local (gitignored). Do not put secrets in client-exposed NEXT_PUBLIC_* vars
# unless you understand they are embedded in the browser bundle.

# Backend API base URL (optional; defaults to http://localhost:8000 in lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: show which email to use for seeded dev login (password is never public)
# Must match SEED_ADMIN_EMAIL (same rules as the API — e.g. admin@example.com).
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=admin@example.com
