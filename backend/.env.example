# Copy to .env in this directory. Never commit .env or real keys.
#
# Google Gemini (required for generation and patching)
GEMINI_API_KEY=

# Tavily — optional; enrichment is skipped if empty
TAVILY_API_KEY=

# Pioneer — optional; if empty, classifier defaults to treating documents as relevant
PIONEER_API_KEY=

# SQLite async URL; file is created relative to the process working directory
# when you run uvicorn from ./backend, the database file appears in ./backend/
DATABASE_URL=sqlite+aiosqlite:///./contexthaus.db

# JWT signing secret for user sessions — required in production; dev default exists in code
JWT_SECRET=

# Optional: access token lifetime in days (default 7)
# JWT_EXPIRE_DAYS=7

# --- One default dev account (only when the users table is empty) ---
# Set SEED_DEFAULT_ACCOUNT=true and a password (8+ chars) to skip manual /bootstrap once.
# Never use these values in production or commit a real .env.
# SEED_DEFAULT_ACCOUNT=true
# SEED_ORG_NAME=Demo Organization
# Use a syntactically valid address (admin@localhost is rejected by the API).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeThis_Dev_Only_1
# SEED_ADMIN_FULL_NAME=Local Admin

# --- Known user in your existing DB (create or reset password) ---
# Run from backend/: ALLOW_KNOWN_USER_SETUP=true KNOWN_USER_PASSWORD='...' python -m app.cli.ensure_known_user
# NEVER enable in production deployments; remove from .env after use if you prefer.
# ALLOW_KNOWN_USER_SETUP=true
# KNOWN_USER_EMAIL=admin@example.com
# KNOWN_USER_PASSWORD=ChangeThis_Dev_Only_1
# KNOWN_USER_FULL_NAME=Dev Admin
# KNOWN_USER_ORG_NAME=Local Dev
