# Copy to .env in this directory. Never commit .env or real keys.
#
# Google Gemini (required for generation and patching)
GEMINI_API_KEY=

# Tavily — optional; enrichment is skipped if empty
TAVILY_API_KEY=

# Pioneer — optional; if empty, classifier defaults to treating documents as relevant
PIONEER_API_KEY=

# SQLite async URL; file is created relative to the process working directory
# when you run uvicorn from ./backend, the database file appears in ./backend/
DATABASE_URL=sqlite+aiosqlite:///./contexthaus.db
